# Postgres connection string (Render: the shared database's External/Internal URL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/portfolio
# Postgres schema that holds this app's tables
DB_SCHEMA=breast_cancer
# Allowed browser origins, comma-separated
FRONTEND_URL=http://localhost:5204
# Groq key for /api/explain (https://console.groq.com/keys). Leave empty to disable AI explanations.
GROQ_API_KEY=
# Optional overrides
# GROQ_MODEL=openai/gpt-oss-120b
# FLASK_ENV=production
